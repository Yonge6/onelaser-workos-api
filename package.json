{
  "name": "onelaser-workos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OneLaser task and OKR API development MVP with evidence and human review",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node build/src/server.js",
