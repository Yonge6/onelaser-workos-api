{
    admin off
    auto_https off
}

http://:{$PORT:10000} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        ?Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    @private_or_uncached not path /wiki/data/* /wiki/assets/* /caldock/assets/*
    header @private_or_uncached Cache-Control no-store
    # The original public Wiki keeps its existing framing restriction. Every
    # other same-origin route retains DENY/none, including the employee app/API.
    @not_wiki not path /wiki/*
    header @not_wiki {
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://login.dingtalk.com"
    }
    # Enable only after the approved origin is switched. Keep the destination
    # literal: neither an incoming Host nor arbitrary environment text is a URL.
    @old_render_origin {
        host onelaser-workos.onrender.com
        expression `{env.APP_PUBLIC_URL} == 'https://craftos.app' || {env.APP_PUBLIC_URL} == 'https://craftos.app/'`
        not path /healthz /api/health
    }
    redir @old_render_origin https://craftos.app{uri} 307
    handle /healthz {
        rewrite * /health
        reverse_proxy 127.0.0.1:3001
    }
    @bot_oauth_metadata path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/api/integrations/grok-bot/mcp /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/api/integrations/grok-bot/oauth
    handle @bot_oauth_metadata {
        reverse_proxy 127.0.0.1:3001
    }
    handle_path /api/* {
        reverse_proxy 127.0.0.1:3001
    }
    handle /api {
        redir * /api/ 308
    }
    handle /decision-studio {
        redir * /decision-studio/?{http.request.uri.query} 308
    }
    handle_path /decision-studio/* {
        root * /app/caldock/decision-studio
        file_server
    }
    handle /caldock {
        redir * /caldock/?{http.request.uri.query} 308
    }
    @caldock_public_assets path /caldock/assets/*
    header @caldock_public_assets Cache-Control "public, max-age=86400"
    handle_path /caldock/* {
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        root * /app/caldock
        file_server
    }
    handle /wiki {
        redir * /wiki/?{http.request.uri.query} 308
    }
    # These are pinned public documentation files, never employee/API content.
    @wiki_public_json path /wiki/data/*
    header @wiki_public_json Cache-Control "public, max-age=300"
    @wiki_public_assets path /wiki/assets/*
    header @wiki_public_assets Cache-Control "public, max-age=86400"
    handle_path /wiki/* {
        header {
            X-Frame-Options SAMEORIGIN
            # Seven original image hosts plus the verified Mubu redirect host.
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://wiki.1laser.com https://zohodesk.1laser.com https://www.1laser.com https://encrypted-tbn0.gstatic.com https://weacrylic.com https://images.openai.com https://api2.mubu.com https://document-image.mubu.com; connect-src 'self'; font-src 'self'; frame-src 'none'; media-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'"
        }
        root * /app/wiki
        file_server
    }
    handle {
        # Native Wiki articles render in the employee shell. Permit only their
        # audited image hosts and disable child frames; API/OAuth policy stays above.
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://wiki.1laser.com https://zohodesk.1laser.com https://www.1laser.com https://encrypted-tbn0.gstatic.com https://weacrylic.com https://images.openai.com https://api2.mubu.com https://document-image.mubu.com; connect-src 'self'; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://login.dingtalk.com"
        root * /app/public
        file_server
    }
}
