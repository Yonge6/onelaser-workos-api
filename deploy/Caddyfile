{
    admin off
    auto_https off
}

http://:{$PORT:10000} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        ?Referrer-Policy no-referrer
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-src https://yonge6.github.io/onelaser-support-center/; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://login.dingtalk.com"
        Cache-Control no-store
    }
    # Enable only after the approved origin is switched. Keep the destination
    # literal: neither an incoming Host nor arbitrary environment text is a URL.
    @old_render_origin {
        host onelaser-workos.onrender.com
        expression `{env.APP_PUBLIC_URL} == 'https://craftos.app' || {env.APP_PUBLIC_URL} == 'https://craftos.app/'`
        not path /healthz /api/health
    }
    redir @old_render_origin https://craftos.app{uri} 307
    handle /healthz {
        rewrite * /health
        reverse_proxy 127.0.0.1:3001
    }
    @bot_oauth_metadata path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/api/integrations/grok-bot/mcp /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/api/integrations/grok-bot/oauth
    handle @bot_oauth_metadata {
        reverse_proxy 127.0.0.1:3001
    }
    handle_path /api/* {
        reverse_proxy 127.0.0.1:3001
    }
    handle /api {
        redir /api/ 308
    }
    handle {
        root * /app/public
        file_server
    }
}
