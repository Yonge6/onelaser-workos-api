# Configuration reference only. Export variables or use your deployment secret manager.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Disabled by default. Production must never enable development identity login.
ALLOW_DEV_LOGIN=false
# Generate a random value with at least 32 characters when explicitly enabling dev login.
DEV_LOGIN_SECRET=
# Insert fictional development fixtures only when explicitly requested.
SEED_DEMO=false

# Local development only; ignored by Git.
PGLITE_DATA_DIR=.runtime/pglite
# Supply the actual PostgreSQL URL securely for a server environment.
DATABASE_URL=

# Same-origin application URL. Render's RENDER_EXTERNAL_URL is also supported.
APP_PUBLIC_URL=
# Set true only after the frontend is served beside /api on the same origin.
FRONTEND_CONNECTED=false
# Code defaults to strict department scope. A small company may explicitly use company.
WORKOS_TEAM_MODE=department
WORKOS_TEAM_NAME=OneLaser

# Enterprise application credentials belong only in the deployment secret manager.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
# Defaults to APP_PUBLIC_URL + /api/auth/dingtalk/callback.
DINGTALK_REDIRECT_URI=
# Explicit vendor department IDs and manager user IDs, comma-separated.
DINGTALK_ALLOWED_DEPARTMENT_IDS=
# Optional exact enterprise user IDs outside those departments; company mode only.
# Grants membership only. Manager and executive permissions remain separate.
DINGTALK_ADDITIONAL_USER_IDS=
DINGTALK_MANAGER_USER_IDS=
DINGTALK_AGENT_ID=
DINGTALK_NOTIFICATIONS_ENABLED=false

# api (default) uses a separate model API key. bot uses an explicitly configured routine + MCP.
AI_REVIEW_MODE=api
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.x.ai/v1
AI_MODEL_ID=
AI_REVIEW_TIMEOUT_MS=45000

# Optional Grok Bot mode. Values stay server-side; do not put them in frontend runtime config.
# Code defaults to bearer for existing integrations; Render explicitly selects oauth.
GROK_BOT_MCP_AUTH_MODE=bearer
# OAuth only: exact administrator-approved callback URIs, comma-separated. Empty disables OAuth.
# HTTPS, the one exact Cursor native callback, or literal HTTP loopback with a fixed port/path.
# No callback list is enabled or guessed by default; check the current client request/official metadata.
GROK_BOT_OAUTH_REDIRECT_URIS=
# Optional exact HTTPS client ID mapped locally to the approved callbacks. No metadata is fetched.
GROK_BOT_OAUTH_PRE_REGISTERED_CLIENT_ID=
# Exact public HTTPS routine URL; no embedded credentials, query, fragment or custom port.
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_SECRET=
# Explicitly approve the exact hostname from the routine URL; no default vendor host is assumed.
GROK_BOT_WEBHOOK_ALLOWED_HOST=
# bearer compatibility mode only: independent random secret (>=32 characters).
# OAuth mode uses manager consent + PKCE tokens; do not send a static worker secret into Bot chat.
GROK_BOT_WORKER_TOKEN=
# Explicit allowed tenant. Falls back to DINGTALK_CORP_ID when that value is configured.
GROK_BOT_ORG_ID=
# Fixed pilot limits: 10 new dispatch attempts/organization/UTC hour, 5/user/minute.
# No automatic dispatch retry. Jobs expire after 30 minutes; a claimed lease after at most 5 minutes.
